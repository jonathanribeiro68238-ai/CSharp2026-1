@page "/listadeusuarios"
@using ProjetoWeb.Dados
@using ProjetoWeb.Classes.Entidades
@using Microsoft.EntityFrameworkCore
@inject AlunoContext alunoContext
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Sections
<CabecalhoPagina />

<section class="lista-alunos-section">
    <div class="lista-alunos-container">
        <div class="lista-alunos-cabecalho">
            <h2 class="lista-alunos-titulo">
                Lista de Alunos
            </h2>
            <!--Implementar logica para contagem-->
            <span class="contador">
                0 Cadastros
            </span>
        </div>
        <div class="tabela-w">
            <table class="tabela-alunos">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Curso</th>
                        <th>Wifi</th>
                        <th>Ações</th>
                    </tr>

                </thead>
                <tbody class="tabela-alunos2">
                    <!--Exemplo estático p/ visualização (Remover quando implementar C#)-->
                    <tr>
                        <td>Clodoaldo</td>
                        <td>BackEnd</td>
                        <td>Inativo</td>
                        <td>Aguardando aprovação</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

